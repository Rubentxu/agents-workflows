{
  "name": "agents-workflows-tests",
  "version": "0.1.0",
  "description": "E2E tests for agents-workflows MCP server",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test e2e/api.spec.ts",
    "test:mcp": "playwright test e2e/mcp.spec.ts",
    "test:workflows": "playwright test e2e/workflows.spec.ts",
    "test:all": "playwright test",
    "test:local": "E2E_MODE=attach SKIP_CONTAINER_CHECK=1 playwright test",
    "test:ui:local": "E2E_MODE=attach SKIP_CONTAINER_CHECK=1 playwright test --project=chromium",
    "test:typecheck": "tsc --noEmit",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:container:up": "bash containers/start-container.sh",
    "test:container:down": "bash containers/stop-container.sh",
    "test:container:restart": "bash containers/stop-container.sh && bash containers/start-container.sh",
    "container:logs": "podman logs -f agents-workflows-tests",
    "report:html": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "podman": ">=5.0.0"
  }
}
