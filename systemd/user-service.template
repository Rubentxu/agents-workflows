[Unit]
Description=agents-workflows MCP Server
Requires=agents-workflows.socket
After=network.target

[Service]
Type=oneshot
ExecStart=__USER_INSTALL_DIR__/workflow-mcp start
ExecStartPre=__USER_INSTALL_DIR__/workflow-mcp init
RemainAfterExit=yes
Environment=WORKSPACE_DIR=%h/.workflows
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
